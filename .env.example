# Placeholder only. Set the real value as a Salad Secret/runtime environment value.
# Do not put the real password in GitHub Actions, source control, or the image.
JUPYTER_PASSWORD=replace-with-a-long-random-password

# Select exactly one backend for this container restart; there is no image default.
ASR_BACKEND=parakeet
# Positive integer; every Parakeet worker loads its own full model instance.
# Increase only for measured concurrency experiments on Salad GPU.
ASR_WORKERS=1

# Runtime-only Salad Secret. Generate a unique value of at least 32 random bytes.
ASR_API_TOKEN=replace-with-a-random-token

# Optional Salad Secret only if Hugging Face model access requires it.
# HF_TOKEN=
