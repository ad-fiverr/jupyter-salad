# Placeholder only. Set the real value as a Salad Secret/runtime environment value.
# Do not put the real password in GitHub Actions, source control, or the image.
JUPYTER_PASSWORD=replace-with-a-long-random-password

# Select the production/offline backend. Allowed: parakeet|faster_whisper.
# Qwen streaming is a separate opt-in experiment; see below.
ASR_BACKEND=parakeet
# Offline Parakeet/Faster-Whisper workers only. Each worker owns a full model.
# Qwen uses one vLLM process and ignores ASR_WORKERS.
ASR_WORKERS=1

# Runtime-only Salad Secret. Generate a unique value of at least 32 random bytes.
ASR_API_TOKEN=replace-with-a-random-token

# The full Python/Torch/Jupyter/NeMo verifier already runs during image build.
# Startup uses metadata-only checks; set to 1 only to repeat the slower checks at runtime.
# SALAD_FULL_RUNTIME_VERIFY=0

# Optional Salad Secret only if Hugging Face model access requires it.
# HF_TOKEN=

# Experimental only: build a separate image with --build-arg INSTALL_QWEN_RUNTIME=1, then
# set QWEN_STREAMING_ENABLED=1. ASR_BACKEND stays parakeet|faster_whisper.
# The normal image does not include Qwen/vLLM. Audio is pushed every 100 ms;
# decode runs when the accumulated audio reaches QWEN_STREAM_CHUNK_MS.
QWEN_STREAMING_ENABLED=0
QWEN_STREAM_CHUNK_MS=1000
QWEN_LANGUAGE=auto
QWEN_UNFIXED_CHUNK_NUM=2
QWEN_UNFIXED_TOKEN_NUM=5
QWEN_GPU_MEMORY_UTILIZATION=0.65
QWEN_MAX_ACTIVE_STREAMS=6
QWEN_MAX_PENDING_JOBS=24
QWEN_MAX_BACKLOG_CHUNKS=4
QWEN_MAX_STREAM_SECONDS=60
QWEN_SESSION_IDLE_TTL_SECONDS=120
QWEN_MAX_CONTEXT_CHARS=512
# Optional interpreter override; normal image path:
# QWEN_ASR_PYTHON=/opt/qwen-asr-venv/bin/python
# Qwen downloads its pinned checkpoint during runtime; use HF_TOKEN as a Salad
# Secret only if Hugging Face requires authentication. Never commit its value.
